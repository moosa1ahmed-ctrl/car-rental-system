<Window x:Class="CarRental_CP317.UserSetup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarRental_CP317"
        mc:Ignorable="d"
        Title="UserSetup" Height="466" Width="653" Background="#FF1A1A1A"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <!-- Reusable rounded button style. Change CornerRadius to adjust roundness -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Background" Value="#FFE05953"/>
            <Setter Property="BorderBrush" Value="#FFB34944"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid HorizontalAlignment="Center" Margin="0,0,0,138">
        <Canvas x:Name="LoginCanvas" Height="382" Canvas.Left="60" Canvas.Top="34" Width="534" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0">
            <Label x:Name="TitleLabel" Content="Profile Setup" FontSize="36" HorizontalAlignment="Left" Height="62" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" Width="251" FontWeight="Bold" Canvas.Left="1" VerticalAlignment="Center" Foreground="White" Background="{x:Null}"/>
            <Label x:Name="FirstNameLabel" Content="First Name" FontSize="14" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Width="115" Canvas.Top="88" VerticalAlignment="Center" Foreground="White" />
            <TextBox x:Name="FirstNameTextBox" TextWrapping="NoWrap" HorizontalAlignment="Left" FontSize="14" Height="32" Text="" VerticalContentAlignment="Center" Width="230" Canvas.Top="117" VerticalAlignment="Center" BorderBrush="#FFE05953" Foreground="White" Background="{x:Null}" CaretBrush="White"/>
            <Label x:Name="LastNameLabel" Content="Last Name" FontSize="14" HorizontalContentAlignment="Left" Width="96" Canvas.Top="166" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="White" />
            <Button x:Name="SubmitButton" Style="{StaticResource RoundedButton}" Content="Submit" FontWeight="Bold" FontSize="14" Height="32" Canvas.Left="366" Canvas.Top="351" Width="104" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FFE05953" BorderBrush="#FFB34944" Foreground="White" Click="SubmitButton_Click"/>
            <TextBox x:Name="LastNameTextBox" TextWrapping="NoWrap" FontSize="14" Height="32" Text="" VerticalContentAlignment="Center" Width="230" Canvas.Left="1" Canvas.Top="195" BorderBrush="#FFE05953" Foreground="White" Background="{x:Null}" CaretBrush="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Label x:Name="AddressLabel" Content="Address" FontSize="14" HorizontalContentAlignment="Left" Width="115" Canvas.Left="303" Canvas.Top="88" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBox x:Name="AddressTextBox" TextWrapping="NoWrap" FontSize="14" Height="32" Text="" VerticalContentAlignment="Center" Width="230" Canvas.Left="303" Canvas.Top="117" BorderBrush="#FFE05953" Foreground="White" Background="{x:Null}" CaretBrush="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Label x:Name="CityLabel" Content="City" FontSize="14" HorizontalContentAlignment="Left" Width="96" Canvas.Left="303" Canvas.Top="166" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBox x:Name="CityTextBox" TextWrapping="NoWrap" FontSize="14" Height="32" Text="" VerticalContentAlignment="Center" Width="230" Canvas.Left="304" Canvas.Top="195" BorderBrush="#FFE05953" Foreground="White" Background="{x:Null}" CaretBrush="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <ComboBox x:Name="ProvinceComboBox" Height="32" Canvas.Left="304" Canvas.Top="273" Width="230" HorizontalAlignment="Left" VerticalAlignment="Center" IsReadOnly="True">
                <ComboBoxItem Content="Alberta"/>
                <ComboBoxItem Content="British Colombia"/>
                <ComboBoxItem Content="Manitoba"/>
                <ComboBoxItem Content="New Brunswick"/>
                <ComboBoxItem Content="Newfoundland and Labrador"/>
                <ComboBoxItem Content="Nova Scotia"/>
                <ComboBoxItem Content="Northwest Territories"/>
                <ComboBoxItem Content="Nunavut"/>
                <ComboBoxItem Content="Ontario"/>
                <ComboBoxItem Content="Prince Edward Island"/>
                <ComboBoxItem Content="Quebec"/>
                <ComboBoxItem Content="Saskatchewan"/>
                <ComboBoxItem Content="Yukon"/>
            </ComboBox>
            <Label x:Name="PhoneNumLabel" Content="Phone Number" FontSize="14" HorizontalContentAlignment="Left" Width="115" Canvas.Top="244" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBox x:Name="PhoneNumTextBox" TextWrapping="NoWrap" FontSize="14" Height="32" Text="" VerticalContentAlignment="Center" Width="230" Canvas.Left="1" Canvas.Top="273" BorderBrush="#FFE05953" Foreground="White" Background="{x:Null}" CaretBrush="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Label x:Name="ProvinceLabel" Content="Province" FontSize="14" HorizontalContentAlignment="Left" Width="96" Canvas.Left="303" Canvas.Top="244" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <Label x:Name="CreditCardNumLabel" Content="Credit Card Number (Optional)" FontSize="14" HorizontalContentAlignment="Left" Width="230" Canvas.Top="322" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBox x:Name="CreditCardNumTextBox" TextWrapping="NoWrap" FontSize="14" Height="32" Text="" VerticalContentAlignment="Center" Width="230" Canvas.Top="351" BorderBrush="#FFE05953" Foreground="White" Background="{x:Null}" CaretBrush="White" HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="1"/>
        </Canvas>

    </Grid>
</Window>
